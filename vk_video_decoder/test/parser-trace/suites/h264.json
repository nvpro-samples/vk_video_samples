{
  "codec": "h264",
  "defects": {
    "sps-constraint-flags": "the parser takes constraint_setN_flag of the Std SPS from bit N of the byte, which the stream codes most significant bit first: constraint_set0_flag and constraint_set1_flag read the reserved zero bits, and constraint_set2_flag to constraint_set5_flag hold constraint_set5_flag to constraint_set2_flag"
  },
  "adapter_defects": {
    "begin-setup-inactive": "the begin-coding list names the setup picture under its target slot, which is not active yet: activation happens in the decode",
    "begin-setup-mismatch": "the begin-coding list names the setup picture under its target slot, which still holds the picture it held before",
    "begin-duplicate": "a second field's setup names its first field's slot and picture, which its reference entry already names",
    "nonexisting": "a non-existing reference takes another reference's picture and a slot no decode set up"
  },

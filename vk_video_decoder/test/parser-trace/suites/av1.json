{
  "codec": "av1",
  "defects": {
    "setup-sign-bias": "the setup slot's RefFrameSignBias comes from buffer 0 with bit 0 set, in the current-minus-reference sense",
    "ref-sign-bias": "a reference's RefFrameSignBias is set for equal order hints and when order hints are off",
    "setup-frame-type": "setupSlotInfo.frame_type is never set and reads as KEY_FRAME; the adapter replaces it until the adapter forwards setupSlotInfo",
    "setup-saved-order-hints-intra": "a shown key frame keeps the previous frame's OrderHints",
    "ref-saved-order-hints-intra": "a shown key frame keeps the previous frame's OrderHints",
    "hdr-order-hint": "a frame with reduced_still_picture_header keeps the previous frame's OrderHint",
    "setup-order-hint": "a frame with reduced_still_picture_header keeps the previous frame's OrderHint"
  },
